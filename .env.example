# ==========================================
# NEX PLAY - Environment Configuration Example
# ==========================================

# Frontend Configuration
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000

# Backend Configuration
PORT=4000
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:3001

# ==========================================
# Temporary ngrok Testing:
# ==========================================
# 1. Start tunnels:
#    ngrok http 4000  (Backend)
#    ngrok http 3001  (Frontend)
#
# 2. Update frontend/.env:
#    VITE_API_URL=https://<NGROK_BACKEND_URL>
#    VITE_WS_URL=wss://<NGROK_BACKEND_URL>
#
# 3. Update backend/.env:
#    FRONTEND_ORIGIN=https://<NGROK_FRONTEND_URL>
